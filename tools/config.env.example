####################################################################
# tools/ configuration - the ONE file you edit before running 00..05.
#
#   cp tools/config.env.example tools/config.env
#   $EDITOR tools/config.env
#
# Gitignored: it names real infrastructure and a key path.
####################################################################

# ------------------------------------------------------------------
# AWS placement
# ------------------------------------------------------------------
AWS_REGION=us-east-1

# Cube only runs on bare metal (it needs /dev/kvm), so this must be a
# .metal / .metal-48xl type. The four target types for this benchmark:
#   m7i.metal-48xl  m8i.metal-48xl  m8g.metal-48xl  m9g.metal-48xl
INSTANCE_TYPE=m8g.metal-48xl

# Placement. Leave ALL FOUR empty for the zero-config path: the benchmark
# instance is placed in the SAME VPC, SUBNET and SECURITY GROUPS as the
# machine you run these scripts from, read from its instance metadata.
# Reachability is then guaranteed by construction - a self-referencing
# inbound rule, which the VPC default group has, permits traffic precisely
# because both ends are members of the group.
#
# Nothing here is ever created. A network these scripts invented could
# easily be somewhere this workstation cannot reach, which is the failure
# this default exists to avoid.
#
# Precedence, most specific first:
#   VPC      SUBNET_ID's VPC > VPC_ID > this workstation's VPC > default VPC
#   subnet   SUBNET_ID > AVAILABILITY_ZONE > this workstation's subnet, then
#            any other subnet in the same VPC when that AZ is out of
#            capacity (still reachable: same VPC, same groups)
#   groups   SECURITY_GROUP_ID > this workstation's groups > VPC default
#
# If this machine is not an EC2 instance there is no metadata to read, and
# the scripts fall back to the default VPC and its default security group.
#
# Bare metal 48xl capacity is not available in every AZ, so with
# AVAILABILITY_ZONE empty the script walks the offered AZs in turn - this
# workstation's own AZ first - instead of failing on the first refusal.
VPC_ID=
SUBNET_ID=
AVAILABILITY_ZONE=

# Leave empty to inherit this workstation's security groups.
#
# Note the VPC default group allows ALL ports between its members, not just
# 22, so anything else in that group can reach the UNAUTHENTICATED CubeAPI
# on :3000 and the web console on :12088. Nothing from the internet can: the
# default group has no CIDR-based inbound rule at all, even when the
# instance has a public IP. Set an explicit group here if that shared-group
# exposure matters in your account.
#
# Whatever ends up in effect, 00-preflight.sh and 01-create-instance.sh both
# check that it actually permits SSH from this host, rather than letting a
# missing rule surface as an unexplained timeout minutes later.
SECURITY_GROUP_ID=

# Public IPv4 address:
#   auto - inherit the subnet's MapPublicIpOnLaunch attribute (default).
#          Default-VPC subnets have it ON, so the instance GETS a public IP.
#   yes  - force one on.
#   no   - force it off. Only do this if the subnet has another egress path
#          (NAT gateway, or VPC endpoints for S3/ECR/SSM). 03-setup-env.sh downloads
#          Docker packages, the ~400 MB CubeSandbox bundle from GitHub and
#          the datasets, so with no egress it hangs on the first download.
#
# Note the public IP is not what protects you either way: the security
# group is. This host runs an UNAUTHENTICATED CubeAPI on :3000 and a web
# console on :12088, so keep inbound restricted to 22 from inside the VPC
# and never "just open a port to debug" on a box with a public IP.
# 01-create-instance.sh always SSHes to the PRIVATE address regardless of this setting.
ASSOCIATE_PUBLIC_IP=auto

# EC2 key pair NAME (as registered in EC2) and the matching private key on
# THIS machine. If the .pem is not mode 600, lib.sh keeps a private 600
# copy under ~/.ssh rather than changing the original.
KEY_NAME=ericyq-global
SSH_KEY_PATH=/home/ubuntu/ericyq-global.pem
SSH_USER=ubuntu

# REQUIRED for the ECR path: the instance pulls and pushes container
# images, and CubeSandbox pulls the template image with a token the
# instance mints for itself. Needs at least
# AmazonEC2ContainerRegistryPowerUser (plus s3:PutObject if S3_BUCKET is
# set in the generated .env).
# Without it, 03-setup-env.sh fails at the image build with an ECR 401.
IAM_INSTANCE_PROFILE=SSMDefaultRoleForPVREReporting

# Tag applied to the instance and both volumes, so a forgotten box is easy
# to find and attribute.
INSTANCE_NAME=arl-bench
EXTRA_TAGS="project=agentic-rl-bench"

# ------------------------------------------------------------------
# EBS - see README.md for how these numbers were derived from measurements
# ------------------------------------------------------------------
# Root: OS, Docker images, the Cube one-click bundle, MySQL's docker
# volume, datasets, venv. 100 GiB is deliberate slack: on the c7g.metal
# trial a 38 GiB root hit 89% because template rootfs images (~3 GiB each)
# landed there, and template builds then failed with a misleading
# "insufficient disk space".
ROOT_VOLUME_GB=100

# Data: /data - template rootfs images, per-sandbox CoW layers, snapshots,
# CubeMaster staging. MUST end up XFS with reflink=1; 02-prepare-disks.sh does that.
DATA_VOLUME_GB=1024

# gp3, not io2: measured disk await on gp3 was 0.79-1.05 ms against a
# 55-135 ms create, so the volume's latency is nowhere near the critical
# path and io2's sub-500us would buy nothing.
#
# 40,000 IOPS covers the extrapolated need for the seven benchmarks at
# high concurrency (~31,000) with headroom. The create-heavy B8 reached
# 5,229 IOPS p95 at only c=4, so if you push concurrency hard, watch
# resource.disk.iops_p95 / disk_saturated in the results and raise this -
# gp3 IOPS can be modified online (Elastic Volumes), though there is a
# 6-hour cooldown between modifications.
# gp3 ceilings: 80,000 IOPS (needs >=160 GiB), 2,000 MiB/s.
DATA_VOLUME_IOPS=40000
DATA_VOLUME_THROUGHPUT=1000

# Where the data volume is requested in the block device mapping. On Nitro
# this is NOT the name Linux will show - the kernel enumerates NVMe
# devices in response order. 02-prepare-disks.sh finds the device by matching the EBS
# volume ID against the NVMe serial, never by name.
DATA_DEVICE_NAME=/dev/sdb
DATA_MOUNT=/data

# ------------------------------------------------------------------
# Benchmark configuration pushed to the instance's .env by 03-setup-env.sh
# ------------------------------------------------------------------
# Required. ECR strongly preferred - the plain-HTTP local registry path is
# not verified against Cube's template pull.
REGISTRY=022633198646.dkr.ecr.us-east-1.amazonaws.com/agentic-rl-bench-on-cube

# Overrides PREPENDED to the generated .env, one KEY=VALUE per line.
# Prepended rather than appended on purpose: load_env() in scripts/_lib.sh
# only sets a key if it is not already set, so within the file the FIRST
# occurrence wins and appending would silently do nothing.
#
# Empty means "use env.example as-is", which is already tuned for a
# .metal-48xl (192 vCPU / 768 GiB): CONCURRENCIES up to 1024,
# DURATION_SEC=300. Uncomment the block below for a quick shakeout run.
BENCH_ENV_OVERRIDES="
"

# A fast first pass - about 12 minutes for all seven, instead of hours.
# Use this to prove the whole pipeline before committing to a real sweep.
BENCH_ENV_OVERRIDES_QUICK="
DURATION_SEC=30
WARMUP_SEC=10
COOLDOWN_SEC=10
CONCURRENCIES=32,128
B1_CONCURRENCIES=32,128
B3_CONCURRENCIES=32,128
B4_CONCURRENCIES=16,32
B5_CONCURRENCIES=32,64
B7_CONCURRENCIES=32,128
B9_CONCURRENCIES=32
B9_DURATION_SEC=60
B8_TRIALS=100
"

# Where the benchmark uploads results, in addition to the local pull that
# 05-run-benchmark.sh does. Leave empty to keep everything local.
S3_BUCKET=ec2-core-benchmark-ericyq
S3_PREFIX=agentic-rl-bench-on-cube
