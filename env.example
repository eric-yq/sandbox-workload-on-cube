####################################################################
# Agentic-RL Sandbox Benchmark on CubeSandbox - configuration template
#
#   cp env.example .env  &&  vim .env
#
# Only REGISTRY is strictly required. Everything else has a working
# default tuned for a *.metal-48xl host (192 vCPU / 768 GiB).
####################################################################

# ------------------------------------------------------------------
# 1. Container image registry (build-time only)
# ------------------------------------------------------------------
# CubeSandbox templates are built from OCI images, so we need a registry
# to hand the image to Cube. Docker is used here as the image builder,
# and separately by Cube's own installer for its dependency containers
# (MySQL, Redis, CubeProxy, CoreDNS, WebUI) - but it is never the
# sandbox runtime. The image is pulled exactly once, at template-build
# time, and converted into a microVM rootfs.
#
# Option A (recommended) - ECR. Attach an instance profile with
#   AmazonEC2ContainerRegistryPowerUser to the metal instance.
#   provision-templates.sh passes the ECR token inline on
#   POST /templates (registryUsername/registryPassword), so nothing has
#   to be configured host-side for Cube to pull it.
#     REGISTRY=<account>.dkr.ecr.us-east-1.amazonaws.com/agentic-rl-bench
#
# Option B - local registry on the same box. build-all.sh will start a
#   `registry:2` container for you and the docker push will work, but the
#   *template build* pull is done by CubeSandbox and may reject a
#   plain-HTTP registry. This path is NOT verified on Cube - prefer ECR.
#     REGISTRY=127.0.0.1:5000/agentic-rl-bench
REGISTRY=022633198646.dkr.ecr.us-east-1.amazonaws.com
# The host architecture is appended automatically, so the image actually
# built and referenced is e.g. arl-sandbox:v2-arm64 / arl-sandbox:v2-amd64.
# The build is native single-arch, so without that suffix an x86_64 and an
# aarch64 host sharing this registry would overwrite each other's manifest.
IMAGE_TAG=v2

# Optional explicit credentials for the template-build pull. Leave unset
# for ECR (derived automatically) or for a public registry.
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=

# ------------------------------------------------------------------
# 2. CubeSandbox services
# ------------------------------------------------------------------
# CubeAPI - the E2B-compatible control plane. Every route is mounted at
# the root prefix, which is what the E2B SDK expects.
CUBE_API_URL=http://127.0.0.1:3000
# Leave EMPTY for a default one-click install: with neither CUBE_API_KEY
# nor AUTH_CALLBACK_URL configured, CubeAPI runs unauthenticated. Set it
# and the same value is used both to configure the server (via
# ensure-cube.sh) and to authenticate the orchestrator, which sends it as
# both `Authorization: Bearer` and `X-API-Key`.
CUBE_API_KEY=

# CubeProxy - the data plane, a SEPARATE process from CubeAPI. This is
# the structural difference from the AgentENV topology, where one process
# served both: here a saturated data plane cannot slow down create/delete
# and vice versa. Port 80 is the one-click default
# (CUBE_PROXY_HTTP_PORT; the shipped nginx.conf's 8081 is rewritten when
# the release bundle is built).
CUBE_PROXY_URL=http://127.0.0.1:80

# CubeOps - node registry. Where the live sandbox count, the per-node
# sandbox ceiling and node health come from. CubeAPI has no /nodes route
# and its /health reports a hardcoded "sandboxes": 0, so without this the
# report loses its node-level columns.
CUBE_OPS_URL=http://127.0.0.1:3010

# ------------------------------------------------------------------
# 3. How the orchestrator reaches services INSIDE a sandbox
# ------------------------------------------------------------------
#   path   - {CUBE_PROXY_URL}/sandbox/<sandbox-id>/<port><path>
#            Default. Needs no Host rewriting and no DNS, so it works
#            against a bare IP on a freshly installed node.
#   host   - {CUBE_PROXY_URL}{path} with Host: <port>-<id>.<domain>
#            The E2B-compatible form, and what the SDK's getHost() hands
#            out. CubeProxy only matches the leading "<port>-<id>" of the
#            Host header, so no DNS record has to exist.
#   direct - http://<sandbox-ip>:<port><path>, no proxy at all.
#            Legitimate rather than a hack: CubeProxy resolves a
#            same-host caller to exactly this address. Takes the shared
#            OpenResty worker pool off the measured path, which matters
#            at high concurrency. Two caveats: it needs CUBE_REDIS_* below
#            (the sandbox IP is in the routing map, not in any API
#            response), and it bypasses the auto-resume gate, so a paused
#            sandbox refuses the connection instead of being woken.
CUBE_TRANSPORT=path
# Cosmetic for `host` transport, but keep it aligned with the server's
# CUBE_API_SANDBOX_DOMAIN so captured URLs are real.
CUBE_SANDBOX_DOMAIN=cube.app

# Only read when CUBE_TRANSPORT=direct. The password below is the
# one-click default (CUBE_SANDBOX_REDIS_PASSWORD in Cube's own env file);
# change it here if you changed it there.
CUBE_REDIS_HOST=127.0.0.1
CUBE_REDIS_PORT=6379
CUBE_REDIS_PASSWORD=ceuhvu123

# Idle TTL handed to every sandbox we create, in SECONDS (E2B uses
# milliseconds; Cube uses seconds). Must comfortably exceed
# WARMUP_SEC + DURATION_SEC.
#
# This one matters more than it looks: Cube ships with
# `default_timeout_insec: -1`, i.e. NO cluster-wide idle reclamation, so a
# sandbox the suite leaks is never collected by anything and holds its
# scheduler quota for the rest of the run. The orchestrator always sends
# an explicit value for exactly that reason.
CUBE_SANDBOX_TIMEOUT_SEC=3600

# ------------------------------------------------------------------
# 4. Rollout -> sandbox mapping
# ------------------------------------------------------------------
# fresh    - create a sandbox, run one rollout, delete it. Maximum
#            isolation; this is what an RL trainer that trusts nothing
#            does, and it is the default.
# pool     - pre-create `concurrency` sandboxes and reuse them across
#            rollouts WITHOUT resetting guest state. Trades isolation for
#            an upper bound on achievable throughput - a reference line,
#            not a headline number. The ONLY strategy here that leaks
#            state between rollouts.
# clone    - keep one warm golden sandbox, snapshot it once, and create
#            every rollout's sandbox from that snapshot: G candidate
#            rollouts from one identical state, i.e. the GRPO shape.
#            Note Cube has no server-side fan-out (no `fork`), so each
#            child is a full create round trip - see CUBE_CLONE_BATCH.
# rollback - Cube-only, and the interesting one. Pre-create a pool,
#            snapshot each member once, then reset a sandbox in place when
#            a rollout hands it back. Pool-like throughput WITHOUT giving
#            up state isolation, which neither containers nor AgentENV
#            could offer.
CUBE_STRATEGY=fresh
# pool / rollback only; 0 = match the concurrency level.
CUBE_POOL_SIZE=0
# clone only: how many children to create per refill, issued
# concurrently. Cube snapshots once and then does N independent creates,
# so this controls pipelining rather than a batch API call.
CUBE_CLONE_BATCH=16

# ------------------------------------------------------------------
# 5. Templates
# ------------------------------------------------------------------
# All templates are built from one unified image (workers/arl-sandbox)
# and differ only in which services their entrypoint launches plus their
# VM shape. These are template *aliases*, created by
# scripts/provision-templates.sh; Cube generates the real tpl- IDs.
TEMPLATE_B1=arl-b1
TEMPLATE_B3=arl-b3
TEMPLATE_B4=arl-b4
TEMPLATE_B5=arl-b5
TEMPLATE_B7=arl-b7
TEMPLATE_B9=arl-b9
TEMPLATE_B8=arl-b8

# Per-sandbox VM shape, applied at template-build time (POST /templates).
# Declared in whole vCPU here and converted to the millicores Cube's API
# takes (2 -> 2000). Scale-out happens by running many sandboxes, not by
# growing one.
SANDBOX_VCPU_B1=2
SANDBOX_MEM_MB_B1=1024
SANDBOX_VCPU_B3=2
SANDBOX_MEM_MB_B3=1024
SANDBOX_VCPU_B4=2
SANDBOX_MEM_MB_B4=2048
SANDBOX_VCPU_B5=2
SANDBOX_MEM_MB_B5=3072
SANDBOX_VCPU_B7=2
SANDBOX_MEM_MB_B7=1024
SANDBOX_VCPU_B9=4
SANDBOX_MEM_MB_B9=4096
SANDBOX_VCPU_B8=2
SANDBOX_MEM_MB_B8=1024
# Writable CoW layer per sandbox. The workloads write very little; this is
# a ceiling, not an allocation.
SANDBOX_WRITABLE_LAYER_SIZE=1G

# ------------------------------------------------------------------
# 6. Episode length (how many environment steps live in one rollout)
# ------------------------------------------------------------------
# B3/B4 already ship one trajectory per rollout, so they need no knob.
# B1/B5 measure a single environment *step* today, so without these
# the sandbox create cost would swamp the actual work.
#   B1: write patch -> run tests -> read failure -> revise
#   B5: write SQL -> run -> see error -> revise
B1_EPISODE_STEPS=8
B5_EPISODE_STEPS=5
# B7 batches episodes into one request; how many per rollout sandbox.
B7_EPISODES_PER_ROLLOUT=1

# Simulated policy-generation delay between two environment steps.
# Real RL rollouts idle here waiting on the GPU, which is precisely when
# a microVM sandbox can be paused and its memory reclaimed. 0 keeps the
# back-to-back behaviour (measures the raw capacity ceiling).
THINK_TIME_MS=0
THINK_TIME_JITTER_MS=0
# With think time > 0, pause the sandbox during the idle window.
# Only meaningful together with THINK_TIME_MS.
THINK_TIME_PAUSE=0

# ------------------------------------------------------------------
# 7. Measurement window
# ------------------------------------------------------------------
DURATION_SEC=300
WARMUP_SEC=30
COOLDOWN_SEC=60

# Concurrency = number of simultaneously live rollout sandboxes.
# Defaults are per-benchmark because the memory cost of one sandbox
# differs by an order of magnitude between B1 and B9 on a 768 GiB box.
#
# Ceiling to be aware of: CubeMaster's `node_max_mvm_num` defaults to
# 3000 sandboxes per node, and the suite flags a level that hits it
# (control_plane.node_at_sandbox_capacity) because such a point did not
# measure the concurrency you asked for.
CONCURRENCIES=32,128,256,512,1024
B1_CONCURRENCIES=64,128,256,512
B3_CONCURRENCIES=64,128,256,512
B4_CONCURRENCIES=64,128,256,512
B5_CONCURRENCIES=64,128,256,512
B7_CONCURRENCIES=64,128,256,512
B9_CONCURRENCIES=64,128,256
B9_DURATION_SEC=1800

# Client-side load generator processes. 0 = one per host vCPU (192),
# capped by CLIENT_NPROCS_MAX to keep httpx pools sane.
CLIENT_NPROCS=0
CLIENT_NPROCS_MAX=64

# ------------------------------------------------------------------
# 8. B8 - microVM lifecycle benchmark
# ------------------------------------------------------------------
B8_TRIALS=500
# Children per clone fan-out: one snapshot, then this many independent
# creates. Also the number that shows whether cloning from live state
# actually beats creating from a template.
B8_CLONE_COUNT=8
# There is no cold-start knob. Cube has no per-sandbox equivalent of a
# cold create - converting an OCI image into a bootable rootfs happens
# once, at template-build time - so the cold path is
# scripts/provision-templates.sh, not something a rollout can pay for.

# ------------------------------------------------------------------
# 9. Host tuning applied by scripts/ensure-cube.sh
# ------------------------------------------------------------------
# Cubelet pre-allocates this many TAP devices. A create burst that drains
# the idle pool blocks on TAP allocation, so the shipped 500 throttles a
# c=1024 sweep - and it does so by degrading create latency, which is
# indistinguishable from a genuine result.
CUBE_TAP_INIT_NUM=1200
# Pre-created sandbox cgroup slots (Cube's default, set explicitly).
CUBE_CGROUP_POOL_SIZE=3000
# Concurrent create/destroy workflows in Cubelet. The shipped 100 is a
# queue rather than a failure at high concurrency, but it caps achievable
# churn for the `fresh` strategy, where every rollout is one create plus
# one destroy.
CUBE_WORKFLOW_CONCURRENT=256
# Where Cubelet stores everything. MUST be XFS with reflink enabled (or
# btrfs): Cube's cubecow storage backend implements snapshot, clone and
# rollback with the FICLONE ioctl, and Ubuntu/Debian default to ext4.
# ensure-cube.sh refuses to proceed otherwise and prints the mkfs command.
CUBE_DATA_DIR=/data/cubelet
# Pin a CubeSandbox release instead of auto-discovering the newest one
# that ships a bundle for this architecture.
# CUBE_VERSION=v0.7.0
# Or install from a tarball you already downloaded.
# CUBE_ONE_CLICK_TARBALL=/opt/cube-sandbox-one-click-v0.7.0-arm64.tar.gz
# Sandbox IP pool. The default 192.168.0.0/18 gives 16382 addresses, ample
# for c=1024, but it must not collide with the VPC subnet.
# CUBE_SANDBOX_NETWORK_CIDR=10.100.0.0/18
# Node IP, if eth0 is not the primary interface.
# CUBE_SANDBOX_NODE_IP=

# ------------------------------------------------------------------
# 10. Workload knobs (unchanged semantics from the Docker version)
# ------------------------------------------------------------------
TPCH_SF=1.0
DUCKDB_THREADS=0
DUCKDB_MEM_LIMIT=

# ------------------------------------------------------------------
# 11. Results
# ------------------------------------------------------------------
RESULTS_DIR=./results
S3_BUCKET=
S3_PREFIX=agentic-rl-bench-on-cube
AWS_REGION=us-east-1

# Skip benchmarks by ID, CSV. B2/B6 have never been implemented.
SKIP=

# ------------------------------------------------------------------
# 12. Pricing for cost-per-unit maths (USD/hour, on-demand)
# ------------------------------------------------------------------
# Exact us-east-1 Linux on-demand prices, verified against the AWS
# Pricing API. The orchestrator matches on the full instance type, so
# add a line here for any instance you benchmark.
#   m8g = Graviton4, m9g = Graviton5.
#   Note m9g.metal-48xl is ~3% ABOVE a linear 12x of m9g.4xlarge, so
#   do not extrapolate - list real prices.
#   c8g/c7i .metal-24xl added for the Graviton4-vs-Intel cost-performance
#   run (exact us-east-1 Linux on-demand, verified via the Pricing API).
INSTANCE_PRICES=m7i.metal-48xl=9.6768,m8i.metal-48xl=10.16064,m8g.metal-48xl=8.61696,m9g.metal-48xl=9.39264,c8g.metal-24xl=3.82848,c7i.metal-24xl=4.284

# Legacy 4xlarge anchors, kept so old result files stay reproducible.
PRICE_C7I_4XL=0.7140
PRICE_C8G_4XL=0.6381
